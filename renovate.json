{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:recommended"
  ],
  "pinDigests": true,
  "packageRules": [
    {
      "matchManagers": [
        "gradle"
      ],
      "matchPackageNames": [
        "org.jetbrains.kotlin.plugin.compose",
        "androidx.compose:compose-bom",
        "io.coil-kt.coil3:coil-compose",
        "com.android.application"
      ],
      "automerge": true
    },
    {
      "matchManagers": [
        "github-actions"
      ],
      "matchPackageNames": [
        "actions/*"
      ],
      "automerge": true
    }
  ]
}
