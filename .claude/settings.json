{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "allow": [
      "Bash(./gradlew:*)",
      "Bash(git:log:*)",
      "Bash(git:diff:*)",
      "Bash(git:mv:*)",
      "Bash(git:show:*)",
      "Bash(find:*)",
      "Read(./**)",
      "mcp__ide__getDiagnostics"
    ],
    "additionalDirectories": [
      "~/.gradle"
    ]
  },
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash \"$CLAUDE_PROJECT_DIR/.claude/setup.sh\"",
            "timeout": 900
          }
        ],
        "matcher": "startup|resume"
      }
    ]
  }
}
